<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <!-- CustomAction pour logger le début de l'installation -->
    <CustomAction 
      Id="LogInstallStart"
      Execute="immediate"
      ExeCommand="powershell.exe -NoProfile -NonInteractive -Command &quot;Add-Content -Path '[INSTALLFOLDER]install.log' -Value ('{0:yyyy-MM-dd HH:mm:ss} - [DEBUT] Installation de CelyaVox' -f [DateTime]::Now) -ErrorAction SilentlyContinue&quot;"
      Return="ignore" />

    <!-- CustomAction pour logger l'enregistrement du protocole -->
    <CustomAction 
      Id="LogProtocolRegistration"
      Execute="deferred"
      ExeCommand="powershell.exe -NoProfile -NonInteractive -Command &quot;Add-Content -Path '[INSTALLFOLDER]install.log' -Value ('{0:yyyy-MM-dd HH:mm:ss} - [PROTOCOLE] Enregistrement du gestionnaire tel: en cours' -f [DateTime]::Now) -ErrorAction SilentlyContinue; Add-Content -Path '[INSTALLFOLDER]install.log' -Value ('{0:yyyy-MM-dd HH:mm:ss} - [CHEMIN] Installation: [INSTALLFOLDER]' -f [DateTime]::Now) -ErrorAction SilentlyContinue&quot;"
      Impersonate="no"
      Return="ignore" />

    <!-- CustomAction pour vérifier les modifications du registre HKLM -->
    <CustomAction 
      Id="LogRegistryVerificationHKLM"
      Execute="deferred"
      ExeCommand="powershell.exe -NoProfile -NonInteractive -Command &quot;Add-Content -Path '[INSTALLFOLDER]install.log' -Value ('{0:yyyy-MM-dd HH:mm:ss} - [REGISTRE] Verification HKLM' -f [DateTime]::Now) -ErrorAction SilentlyContinue; `$telKey = Get-Item 'HKLM:\Software\Classes\tel' -ErrorAction SilentlyContinue; if (`$telKey) { Add-Content -Path '[INSTALLFOLDER]install.log' -Value ('{0:yyyy-MM-dd HH:mm:ss} - [OK] Cle tel: trouvee en HKLM' -f [DateTime]::Now) -ErrorAction SilentlyContinue; `$progId = Get-ItemProperty 'HKLM:\Software\Classes\CelyaVox.tel\shell\open\command' -ErrorAction SilentlyContinue; if (`$progId) { Add-Content -Path '[INSTALLFOLDER]install.log' -Value ('{0:yyyy-MM-dd HH:mm:ss} - [OK] ProgId CelyaVox.tel enregistre: ' + `$progId.'(Default)' -f [DateTime]::Now) -ErrorAction SilentlyContinue } else { Add-Content -Path '[INSTALLFOLDER]install.log' -Value ('{0:yyyy-MM-dd HH:mm:ss} - [ERREUR] ProgId CelyaVox.tel NON trouve' -f [DateTime]::Now) -ErrorAction SilentlyContinue } } else { Add-Content -Path '[INSTALLFOLDER]install.log' -Value ('{0:yyyy-MM-dd HH:mm:ss} - [ERREUR] Cle tel: NON trouvee en HKLM' -f [DateTime]::Now) -ErrorAction SilentlyContinue }; `$regApps = Get-ItemProperty 'HKLM:\Software\RegisteredApplications' -Name 'CelyaVox' -ErrorAction SilentlyContinue; if (`$regApps) { Add-Content -Path '[INSTALLFOLDER]install.log' -Value ('{0:yyyy-MM-dd HH:mm:ss} - [OK] RegisteredApplications CelyaVox enregistre' -f [DateTime]::Now) -ErrorAction SilentlyContinue } else { Add-Content -Path '[INSTALLFOLDER]install.log' -Value ('{0:yyyy-MM-dd HH:mm:ss} - [ERREUR] RegisteredApplications CelyaVox NON enregistre' -f [DateTime]::Now) -ErrorAction SilentlyContinue }&quot;"
      Impersonate="no"
      Return="ignore" />

    <!-- CustomAction pour vérifier les modifications du registre HKCU -->
    <CustomAction 
      Id="LogRegistryVerificationHKCU"
      Execute="deferred"
      ExeCommand="powershell.exe -NoProfile -NonInteractive -Command &quot;Add-Content -Path '[INSTALLFOLDER]install.log' -Value ('{0:yyyy-MM-dd HH:mm:ss} - [REGISTRE] Verification HKCU' -f [DateTime]::Now) -ErrorAction SilentlyContinue; `$telKeyUser = Get-Item 'HKCU:\Software\Classes\tel' -ErrorAction SilentlyContinue; if (`$telKeyUser) { Add-Content -Path '[INSTALLFOLDER]install.log' -Value ('{0:yyyy-MM-dd HH:mm:ss} - [OK] Cle tel: trouvee en HKCU' -f [DateTime]::Now) -ErrorAction SilentlyContinue; `$cmdUser = Get-ItemProperty 'HKCU:\Software\Classes\tel\shell\open\command' -ErrorAction SilentlyContinue; if (`$cmdUser) { Add-Content -Path '[INSTALLFOLDER]install.log' -Value ('{0:yyyy-MM-dd HH:mm:ss} - [OK] Commande enregistree: ' + `$cmdUser.'(Default)' -f [DateTime]::Now) -ErrorAction SilentlyContinue } } else { Add-Content -Path '[INSTALLFOLDER]install.log' -Value ('{0:yyyy-MM-dd HH:mm:ss} - [ERREUR] Cle tel: NON trouvee en HKCU' -f [DateTime]::Now) -ErrorAction SilentlyContinue }&quot;"
      Impersonate="no"
      Return="ignore" />

    <!-- CustomAction pour logger la fin de l'installation -->
    <CustomAction 
      Id="LogInstallEnd"
      Execute="deferred"
      ExeCommand="powershell.exe -NoProfile -NonInteractive -Command &quot;Add-Content -Path '[INSTALLFOLDER]install.log' -Value ('{0:yyyy-MM-dd HH:mm:ss} - [SUCCES] Installation terminee' -f [DateTime]::Now) -ErrorAction SilentlyContinue; Add-Content -Path '[INSTALLFOLDER]install.log' -Value ('{0:yyyy-MM-dd HH:mm:ss} - [INFO] Fichier log: [INSTALLFOLDER]install.log' -f [DateTime]::Now) -ErrorAction SilentlyContinue&quot;"
      Impersonate="no"
      Return="ignore" />

    <!-- Enregistrement direct du protocole tel: dans le registre -->
    
    <!-- Clé principale du protocole -->
    <RegistryKey Root="HKLM" Key="Software\Classes\tel" Action="createAndRemoveOnUninstall">
      <RegistryValue Type="string" Value="URL:tel protocol" />
      <RegistryValue Name="URL Protocol" Type="string" Value="" />
      
      <!-- Commande d'ouverture -->
      <RegistryKey Key="shell\open\command" Action="createAndRemoveOnUninstall">
        <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]CelyaVox.exe&quot; &quot;%1&quot;" />
      </RegistryKey>
    </RegistryKey>

    <!-- Fallback HKCU pour utilisateur sans admin -->
    <RegistryKey Root="HKCU" Key="Software\Classes\tel" Action="createAndRemoveOnUninstall">
      <RegistryValue Type="string" Value="URL:tel protocol" />
      <RegistryValue Name="URL Protocol" Type="string" Value="" />
      
      <RegistryKey Key="shell\open\command" Action="createAndRemoveOnUninstall">
        <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]CelyaVox.exe&quot; &quot;%1&quot;" />
      </RegistryKey>
    </RegistryKey>

    <!-- Enregistrement du ProgId en HKLM -->
    <RegistryKey Root="HKLM" Key="Software\Classes\CelyaVox.tel" Action="createAndRemoveOnUninstall">
      <RegistryValue Type="string" Value="Telephone Link" />
      
      <RegistryKey Key="DefaultIcon" Action="createAndRemoveOnUninstall">
        <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]CelyaVox.exe&quot;,0" />
      </RegistryKey>
      
      <RegistryKey Key="shell\open\command" Action="createAndRemoveOnUninstall">
        <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]CelyaVox.exe&quot; &quot;%1&quot;" />
      </RegistryKey>
    </RegistryKey>

    <!-- Enregistrement du ProgId en HKCU -->
    <RegistryKey Root="HKCU" Key="Software\Classes\CelyaVox.tel" Action="createAndRemoveOnUninstall">
      <RegistryValue Type="string" Value="Telephone Link" />
      
      <RegistryKey Key="DefaultIcon" Action="createAndRemoveOnUninstall">
        <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]CelyaVox.exe&quot;,0" />
      </RegistryKey>
      
      <RegistryKey Key="shell\open\command" Action="createAndRemoveOnUninstall">
        <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]CelyaVox.exe&quot; &quot;%1&quot;" />
      </RegistryKey>
    </RegistryKey>

    <!-- RegisteredApplications en HKLM pour apparaître dans Settings -->
    <RegistryKey Root="HKLM" Key="Software\RegisteredApplications" Action="create">
      <RegistryValue Name="CelyaVox" Type="string" Value="Software\Classes\Applications\CelyaVox.exe\Capabilities" />
    </RegistryKey>

    <!-- Capabilities en HKLM -->
    <RegistryKey Root="HKLM" Key="Software\Classes\Applications\CelyaVox.exe\Capabilities" Action="createAndRemoveOnUninstall">
      <RegistryValue Name="ApplicationName" Type="string" Value="CelyaVox" />
      <RegistryValue Name="ApplicationDescription" Type="string" Value="Telephone and VoIP application" />
      
      <RegistryKey Key="URLAssociations" Action="createAndRemoveOnUninstall">
        <RegistryValue Name="tel" Type="string" Value="CelyaVox.tel" />
      </RegistryKey>
    </RegistryKey>
  </Fragment>

  <Fragment>
    <InstallExecuteSequence>
      <!-- Logs au début -->
      <Custom Action="LogInstallStart" After="AppSearch">NOT Installed</Custom>
      
      <!-- Logs pour le protocole -->
      <Custom Action="LogProtocolRegistration" After="InstallFiles">NOT Installed</Custom>
      
      <!-- Vérification HKLM -->
      <Custom Action="LogRegistryVerificationHKLM" After="LogProtocolRegistration">NOT Installed</Custom>
      
      <!-- Vérification HKCU -->
      <Custom Action="LogRegistryVerificationHKCU" After="LogRegistryVerificationHKLM">NOT Installed</Custom>
      
      <!-- Logs à la fin -->
      <Custom Action="LogInstallEnd" After="InstallFinalize">NOT Installed</Custom>
    </InstallExecuteSequence>
  </Fragment>
</Wix>
