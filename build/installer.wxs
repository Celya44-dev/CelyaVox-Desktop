<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi" xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
  <Fragment>
    <!-- Condition d'élévation pour Windows 11 PRO - Force l'UAC -->
    <CustomAction
      Id="CheckAdminPrivileges"
      Error="CelyaVox requires administrator privileges to install properly on this system."
      Impersonate="no" />

    <!-- CustomAction pour exécuter le batch de postinstall -->
    <CustomAction 
      Id="RunPostInstallBatch"
      Directory="INSTALLFOLDER"
      ExeCommand="cmd.exe /c &quot;[INSTALLFOLDER]postinstall_windows.bat&quot; &quot;[INSTALLFOLDER]&quot;"
      Execute="deferred"
      Impersonate="no"
      Return="check" />

    <!-- Enregistrement direct du protocole tel: dans le registre -->
    
    <!-- Clé principale du protocole en HKLM -->
    <RegistryKey Root="HKLM" Key="Software\Classes\tel" Action="createAndRemoveOnUninstall">
      <RegistryValue Type="string" Value="URL:tel protocol" />
      <RegistryValue Name="URL Protocol" Type="string" Value="" />
      
      <!-- Commande d'ouverture -->
      <RegistryKey Key="shell\open\command" Action="createAndRemoveOnUninstall">
        <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]CelyaVox.exe&quot; &quot;%1&quot;" />
      </RegistryKey>
    </RegistryKey>

    <!-- Fallback HKCU pour utilisateur sans admin -->
    <RegistryKey Root="HKCU" Key="Software\Classes\tel" Action="createAndRemoveOnUninstall">
      <RegistryValue Type="string" Value="URL:tel protocol" />
      <RegistryValue Name="URL Protocol" Type="string" Value="" />
      
      <RegistryKey Key="shell\open\command" Action="createAndRemoveOnUninstall">
        <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]CelyaVox.exe&quot; &quot;%1&quot;" />
      </RegistryKey>
    </RegistryKey>

    <!-- Enregistrement callto: en HKLM -->
    <RegistryKey Root="HKLM" Key="Software\Classes\callto" Action="createAndRemoveOnUninstall">
      <RegistryValue Type="string" Value="URL:callto protocol" />
      <RegistryValue Name="URL Protocol" Type="string" Value="" />
      
      <RegistryKey Key="shell\open\command" Action="createAndRemoveOnUninstall">
        <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]CelyaVox.exe&quot; &quot;%1&quot;" />
      </RegistryKey>
    </RegistryKey>

    <!-- Fallback callto: HKCU pour utilisateur sans admin -->
    <RegistryKey Root="HKCU" Key="Software\Classes\callto" Action="createAndRemoveOnUninstall">
      <RegistryValue Type="string" Value="URL:callto protocol" />
      <RegistryValue Name="URL Protocol" Type="string" Value="" />
      
      <RegistryKey Key="shell\open\command" Action="createAndRemoveOnUninstall">
        <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]CelyaVox.exe&quot; &quot;%1&quot;" />
      </RegistryKey>
    </RegistryKey>

    <!-- Enregistrement du ProgId en HKLM -->
    <RegistryKey Root="HKLM" Key="Software\Classes\CelyaVox.tel" Action="createAndRemoveOnUninstall">
      <RegistryValue Type="string" Value="Telephone Link" />
      
      <RegistryKey Key="DefaultIcon" Action="createAndRemoveOnUninstall">
        <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]CelyaVox.exe&quot;,0" />
      </RegistryKey>
      
      <RegistryKey Key="shell\open\command" Action="createAndRemoveOnUninstall">
        <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]CelyaVox.exe&quot; &quot;%1&quot;" />
      </RegistryKey>
    </RegistryKey>

    <!-- Enregistrement du ProgId en HKCU -->
    <RegistryKey Root="HKCU" Key="Software\Classes\CelyaVox.tel" Action="createAndRemoveOnUninstall">
      <RegistryValue Type="string" Value="Telephone Link" />
      
      <RegistryKey Key="DefaultIcon" Action="createAndRemoveOnUninstall">
        <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]CelyaVox.exe&quot;,0" />
      </RegistryKey>
      
      <RegistryKey Key="shell\open\command" Action="createAndRemoveOnUninstall">
        <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]CelyaVox.exe&quot; &quot;%1&quot;" />
      </RegistryKey>
    </RegistryKey>

    <!-- Enregistrement du ProgId callto en HKLM -->
    <RegistryKey Root="HKLM" Key="Software\Classes\CelyaVox.callto" Action="createAndRemoveOnUninstall">
      <RegistryValue Type="string" Value="Telephone Link" />
      
      <RegistryKey Key="DefaultIcon" Action="createAndRemoveOnUninstall">
        <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]CelyaVox.exe&quot;,0" />
      </RegistryKey>
      
      <RegistryKey Key="shell\open\command" Action="createAndRemoveOnUninstall">
        <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]CelyaVox.exe&quot; &quot;%1&quot;" />
      </RegistryKey>
    </RegistryKey>

    <!-- Enregistrement du ProgId callto en HKCU -->
    <RegistryKey Root="HKCU" Key="Software\Classes\CelyaVox.callto" Action="createAndRemoveOnUninstall">
      <RegistryValue Type="string" Value="Telephone Link" />
      
      <RegistryKey Key="DefaultIcon" Action="createAndRemoveOnUninstall">
        <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]CelyaVox.exe&quot;,0" />
      </RegistryKey>
      
      <RegistryKey Key="shell\open\command" Action="createAndRemoveOnUninstall">
        <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]CelyaVox.exe&quot; &quot;%1&quot;" />
      </RegistryKey>
    </RegistryKey>

    <!-- RegisteredApplications en HKLM pour apparaître dans Settings -->
    <RegistryKey Root="HKLM" Key="Software\RegisteredApplications" Action="create">
      <RegistryValue Name="CelyaVox" Type="string" Value="Software\Classes\Applications\CelyaVox.exe\Capabilities" />
    </RegistryKey>

    <!-- Capabilities en HKLM -->
    <RegistryKey Root="HKLM" Key="Software\Classes\Applications\CelyaVox.exe\Capabilities" Action="createAndRemoveOnUninstall">
      <RegistryValue Name="ApplicationName" Type="string" Value="CelyaVox" />
      <RegistryValue Name="ApplicationDescription" Type="string" Value="Telephone and VoIP application" />
      
      <RegistryKey Key="URLAssociations" Action="createAndRemoveOnUninstall">
        <RegistryValue Name="tel" Type="string" Value="CelyaVox.tel" />
        <RegistryValue Name="callto" Type="string" Value="CelyaVox.callto" />
      </RegistryKey>
    </RegistryKey>
  </Fragment>

  <Fragment>
    <InstallExecuteSequence>
      <!-- Vérifier les privilèges admin avant installation sur Windows 11 PRO -->
      <Custom Action="CheckAdminPrivileges" Before="InstallInitialize">NOT ALLUSERS</Custom>
      
      <!-- Appeler le batch postinstall après installation des fichiers -->
      <Custom Action="RunPostInstallBatch" After="InstallFiles">NOT Installed</Custom>
    </InstallExecuteSequence>
  </Fragment>
</Wix>
