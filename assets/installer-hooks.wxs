<?xml version="1.0" encoding="UTF-8"?>
<!-- Custom WiX configuration for CelyaVox MSI installer
     This file is included by electron-builder to add custom post-installation hooks -->

<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <!-- Custom Action 1: Set property with install folder (immediate) -->
    <CustomAction 
      Id="SetInstallDirProperty" 
      Property="POSTINSTALL_DIR" 
      Value="[INSTALLFOLDER]" 
      Execute="immediate" />
    
    <!-- Custom Action 2: Execute PowerShell post-installation script (deferred) -->
    <CustomAction 
      Id="RunPostInstallScript" 
      BinaryKey="WixCA"
      DllEntry="WixQuietExec"
      Execute="deferred" 
      Impersonate="no"
      Return="ignore">
      powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "[INSTALLFOLDER]postinstall_windows.ps1" -InstallDir "[INSTALLFOLDER]"
    </CustomAction>
    
    <!-- Execute custom actions in sequence -->
    <InstallExecuteSequence>
      <Custom Action="SetInstallDirProperty" Before="RunPostInstallScript">
        <![CDATA[NOT Installed]]>
      </Custom>
      <Custom Action="RunPostInstallScript" After="InstallFiles">
        <![CDATA[NOT Installed]]>
      </Custom>
    </InstallExecuteSequence>
  </Fragment>
</Wix>
